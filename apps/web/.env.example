# Server-only: where the Next.js server reaches the API (also used by the /api rewrite).
API_URL=http://localhost:4000

# Public: canonical site URL used for metadata, sitemap and Open Graph. Production: https://valorian.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: restricts the Next.js image optimizer to your own Cloudinary account (same value as the API's CLOUDINARY_CLOUD_NAME).
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Optional: Google Search Console "HTML tag" verification token (the content="..." value only).
# GOOGLE_SITE_VERIFICATION=
