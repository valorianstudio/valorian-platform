# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Public URL of the website (CORS + cookies). Production: https://valorian.com
WEB_ORIGIN=http://localhost:3000

# Production: use the provider's pooled URL for the app, e.g. append
# ?pgbouncer=true&connection_limit=10 when going through a pooler.
# Run migrations with a direct (non-pooled) URL: DATABASE_URL=<direct> npm run db:deploy
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/valorian?schema=public

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Only used by `npm run db:seed` on a fresh database
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_long_passphrase

# Storage (local disk by default). Keep private-uploads outside the web root.
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads

# Email (Brevo SMTP). Create an SMTP key in Brevo > SMTP & API. Email is skipped, never fatal, until SMTP_HOST is set.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
# EMAIL_FROM=Valorian Studio <hello@valorianstudio.com>
# NOTIFY_EMAIL=hello@valorianstudio.com

# Optional integrations
# LEAD_WEBHOOK_URL=
# ERROR_WEBHOOK_URL=

# Cloudinary image hosting (free plan is enough). Dashboard > Settings > API Keys.
# Required in production: without these, image uploads answer 503 instead of writing to Render's temporary disk.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=valorian

# Seconds-level budget for any single API request before a clean 504 is returned (default 25000)
# REQUEST_TIMEOUT_MS=25000
