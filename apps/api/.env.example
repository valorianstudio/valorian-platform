# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Public URL of the website (CORS + cookies). Production: https://valorian.com
WEB_ORIGIN=http://localhost:3000

# Production: use the provider's pooled URL for the app, e.g. append
# ?pgbouncer=true&connection_limit=10 when going through a pooler.
# Run migrations with a direct (non-pooled) URL: DATABASE_URL=<direct> npm run db:deploy
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/valorian?schema=public

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Only used by `npm run db:seed` on a fresh database
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_long_passphrase

# Storage (local disk by default). Keep private-uploads outside the web root.
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads

# Optional integrations
# LEAD_WEBHOOK_URL=
# MAIL_WEBHOOK_URL=
# MAIL_FROM=Valorian <no-reply@valorian.com>
# ERROR_WEBHOOK_URL=
