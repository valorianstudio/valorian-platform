generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
}

model AdminUser {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String
  role               AdminRole  @default(SUPER_ADMIN)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  roleId             String?
  roleRef            Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean    @default(false)
  tokenVersion       Int        @default(0)
  passwordChangedAt  DateTime?
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  totpSecret         String?
  totpEnabled        Boolean    @default(false)
  backupCodes        String[]
  createdById        String?
  auditLogs          AuditLog[]

  @@index([roleId])
  @@index([isActive])
}

model SiteSetting {
  id              String   @id @default("site")
  brandName       String
  companyName     String
  tagline         String
  description     String
  primaryEmail    String
  secondaryEmail  String?
  phone           String?
  whatsapp        String?
  websiteUrl      String?
  location        String?
  linkedinUrl     String?
  githubUrl       String?
  facebookUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  defaultCurrency String   @default("USD")
  logoLightUrl    String?
  logoDarkUrl     String?
  faviconUrl      String?
  maintenanceMode Boolean  @default(false)
  copyrightText   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageKey {
  DEMOS
  CASE_STUDIES
  INSIGHTS
  CONTACT
  ESTIMATE
  HOME
  ABOUT
  SERVICES
  SOLUTIONS
}

enum NavLocation {
  HEADER
  FOOTER
  LEGAL
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  INFRASTRUCTURE
  MOBILE
  AI
  DEVOPS
}

enum FaqCategory {
  GENERAL
  DEVELOPMENT
  PRICING
  PROCESS
  SUPPORT
}

model Page {
  key             PageKey       @id
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]
}

model PageSection {
  id           String   @id @default(cuid())
  pageKey      PageKey
  key          String
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  content      Json
  updatedAt    DateTime @updatedAt
  page         Page     @relation(fields: [pageKey], references: [key], onDelete: Cascade)

  @@unique([pageKey, key])
  @@index([pageKey, displayOrder])
}

model Service {
  caseStudies      CaseStudy[]           @relation("CaseStudyServices")
  articles         Article[]             @relation("ArticleServices")
  testimonials     Testimonial[]
  leads            Lead[]
  id               String                @id @default(cuid())
  slug             String                @unique
  title            String
  shortDescription String
  description      String
  icon             String                @default("code")
  heroTitle        String?
  heroSubtitle     String?
  features         Json                  @default("[]")
  benefits         String[]
  ctaLabel         String?
  ctaUrl           String?
  featured         Boolean               @default(false)
  status           ContentStatus         @default(DRAFT)
  displayOrder     Int                   @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  technologies     Technology[]          @relation("ServiceTechnologies")
  industries       Industry[]            @relation("IndustryServices")
  estimatorTypeId  String?
  estimatorType    EstimatorProjectType? @relation(fields: [estimatorTypeId], references: [id], onDelete: SetNull)

  @@index([status, displayOrder])
}

model Industry {
  caseStudies       CaseStudy[]
  articles          Article[]          @relation("ArticleIndustries")
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  shortDescription  String
  overview          String
  icon              String             @default("briefcase")
  problems          String[]
  approach          String
  benefits          String[]
  ctaLabel          String?
  ctaUrl            String?
  coverImageUrl     String?
  featured          Boolean            @default(false)
  status            ContentStatus      @default(DRAFT)
  displayOrder      Int                @default(0)
  metaTitle         String?
  metaDescription   String?
  ogImageUrl        String?
  canonicalUrl      String?
  noindex           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  technologies      Technology[]       @relation("IndustryTechnologies")
  services          Service[]          @relation("IndustryServices")
  demos             Demo[]
  estimatorFeatures EstimatorFeature[]

  @@index([status, displayOrder])
}

model Technology {
  caseStudies   CaseStudy[]    @relation("CaseStudyTechnologies")
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  category      TechCategory
  description   String?
  logoUrl       String?
  websiteUrl    String?
  featured      Boolean        @default(false)
  active        Boolean        @default(true)
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  services      Service[]      @relation("ServiceTechnologies")
  industries    Industry[]     @relation("IndustryTechnologies")
  demoPlatforms DemoPlatform[] @relation("DemoPlatformTechnologies")

  @@index([active, featured, displayOrder])
}

model ProcessStep {
  id           String   @id @default(cuid())
  title        String
  label        String?
  description  String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

model ValueProp {
  id           String   @id @default(cuid())
  title        String
  description  String
  icon         String   @default("sparkles")
  highlight    String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

model Faq {
  id           String      @id @default(cuid())
  question     String
  answer       String
  category     FaqCategory @default(GENERAL)
  featured     Boolean     @default(false)
  active       Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, displayOrder])
}

model Cta {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  url         String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavigationItem {
  id           String      @id @default(cuid())
  label        String
  url          String
  location     NavLocation @default(HEADER)
  displayOrder Int         @default(0)
  enabled      Boolean     @default(true)
  openInNewTab Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([location, enabled, displayOrder])
}

model FeaturedWork {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String
  imageUrl     String?
  badge        String?
  ctaUrl       String?
  featured     Boolean  @default(true)
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, featured, displayOrder])
}

enum DemoLabel {
  INTERACTIVE_CONCEPT
  PROTOTYPE
  DEMO_PRODUCT
  PRODUCTION_EXAMPLE
}

enum PlatformType {
  WEBSITE
  MOBILE
}

enum FeaturePlatform {
  WEBSITE
  MOBILE
  BOTH
}

enum ScreenshotKind {
  DESKTOP
  TABLET
  MOBILE
  DASHBOARD
  ADMIN
  CUSTOMER
  OTHER
}

enum PointType {
  BENEFIT
  USE_CASE
}

model DemoCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  demos        Demo[]

  @@index([active, displayOrder])
}

model Demo {
  caseStudies       CaseStudy[]        @relation("CaseStudyDemos")
  leads             Lead[]
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  internalName      String?
  shortDescription  String
  fullDescription   String             @default("")
  categoryId        String?
  industryId        String?
  status            ContentStatus      @default(DRAFT)
  statusLabel       DemoLabel          @default(PROTOTYPE)
  featured          Boolean            @default(false)
  active            Boolean            @default(true)
  coverImageUrl     String?
  thumbnailUrl      String?
  badge             String?
  displayOrder      Int                @default(0)
  publishedAt       DateTime?
  problem           String?
  solution          String?
  targetUsers       String?
  targetBusinesses  String?
  outcomes          String[]
  highlight         String?
  ctaLabel          String?
  ctaUrl            String?
  metaTitle         String?
  metaDescription   String?
  ogImageUrl        String?
  canonicalUrl      String?
  noindex           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          DemoCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  industry          Industry?          @relation(fields: [industryId], references: [id], onDelete: SetNull)
  platforms         DemoPlatform[]
  features          DemoFeature[]
  modules           DemoModule[]
  screenshots       DemoScreenshot[]
  points            DemoPoint[]
  related           Demo[]             @relation("RelatedDemos")
  relatedBy         Demo[]             @relation("RelatedDemos")
  estimatorFeatures EstimatorFeature[]

  @@index([status, active, featured, displayOrder])
  @@index([categoryId])
  @@index([industryId])
}

model DemoPlatform {
  id           String       @id @default(cuid())
  demoId       String
  type         PlatformType
  enabled      Boolean      @default(false)
  title        String?
  description  String?
  demoUrl      String?
  videoUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  notes        String?
  android      Boolean      @default(false)
  ios          Boolean      @default(false)
  playStoreUrl String?
  appStoreUrl  String?
  demo         Demo         @relation(fields: [demoId], references: [id], onDelete: Cascade)
  technologies Technology[] @relation("DemoPlatformTechnologies")

  @@unique([demoId, type])
}

model DemoFeature {
  id           String          @id @default(cuid())
  demoId       String
  platform     FeaturePlatform @default(BOTH)
  title        String
  description  String?
  icon         String?
  featured     Boolean         @default(false)
  active       Boolean         @default(true)
  displayOrder Int             @default(0)
  demo         Demo            @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, displayOrder])
}

model DemoModule {
  id           String          @id @default(cuid())
  demoId       String
  platform     FeaturePlatform @default(BOTH)
  title        String
  description  String?
  icon         String?
  active       Boolean         @default(true)
  displayOrder Int             @default(0)
  demo         Demo            @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, displayOrder])
}

model DemoScreenshot {
  id           String         @id @default(cuid())
  demoId       String
  platform     PlatformType   @default(WEBSITE)
  kind         ScreenshotKind @default(DESKTOP)
  url          String
  altText      String
  caption      String?
  featured     Boolean        @default(false)
  active       Boolean        @default(true)
  displayOrder Int            @default(0)
  demo         Demo           @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, displayOrder])
}

model DemoPoint {
  id           String    @id @default(cuid())
  demoId       String
  type         PointType
  title        String
  description  String?
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  demo         Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, type, displayOrder])
}

enum PricingRuleKind {
  SCALE
  URGENCY
}

enum EstimatorCurrency {
  BDT
  USD
}

model EstimatorSettings {
  id                  String            @id @default("estimator")
  enabled             Boolean           @default(true)
  currency            EstimatorCurrency @default(BDT)
  rangeLowPercent     Int               @default(10)
  rangeHighPercent    Int               @default(10)
  bothDiscountPercent Int               @default(10)
  roundingStep        Int               @default(1000)
  disclaimer          String            @default("Final pricing will be confirmed after detailed requirement analysis.")
  updatedAt           DateTime          @updatedAt
}

model EstimatorProjectType {
  id           String          @id @default(cuid())
  name         String          @unique
  slug         String          @unique
  description  String?
  platform     FeaturePlatform @default(WEBSITE)
  basePrice    Int             @default(0)
  baseWeeks    Int             @default(4)
  active       Boolean         @default(true)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  services     Service[]
}

model EstimatorCategory {
  id           String             @id @default(cuid())
  name         String             @unique
  slug         String             @unique
  active       Boolean            @default(true)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  features     EstimatorFeature[]
}

model EstimatorFeature {
  id           String             @id @default(cuid())
  name         String             @unique
  slug         String             @unique
  description  String?
  categoryId   String?
  websitePrice Int?
  mobilePrice  Int?
  bothPrice    Int?
  effortDays   Int                @default(0)
  required     Boolean            @default(false)
  recommended  Boolean            @default(false)
  active       Boolean            @default(true)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     EstimatorCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  industries   Industry[]
  demos        Demo[]

  @@index([active, displayOrder])
}

model EstimatorIntegration {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  websitePrice Int?
  mobilePrice  Int?
  bothPrice    Int?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EstimatorComplexity {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?
  multiplier     Float    @default(1)
  timelineFactor Float    @default(1)
  active         Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EstimatorPricingRule {
  id             String          @id @default(cuid())
  kind           PricingRuleKind
  key            String
  label          String
  description    String?
  multiplier     Float           @default(1)
  timelineFactor Float           @default(1)
  active         Boolean         @default(true)
  displayOrder   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([kind, key])
}

model EstimatorSubmission {
  sessionId       String?
  lead            Lead?
  id              String            @id @default(cuid())
  projectTypeSlug String
  projectTypeName String
  demoSlug        String?
  industrySlug    String?
  platform        FeaturePlatform
  featureIds      String[]
  integrationIds  String[]
  complexity      String
  scale           String
  urgency         String
  currency        EstimatorCurrency
  minAmount       Int
  maxAmount       Int
  weeksMin        Int
  weeksMax        Int
  breakdown       Json
  name            String?
  email           String?
  phone           String?
  message         String?
  createdAt       DateTime          @default(now())

  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadSource {
  ESTIMATOR
  DEMO
  SERVICE
  CONTACT
  HOMEPAGE
  DIRECT
  OTHER
}

enum ContactMethod {
  EMAIL
  WHATSAPP
  PHONE
  VIDEO_CALL
}

enum LostReason {
  PRICE
  NO_RESPONSE
  CHOSE_COMPETITOR
  PROJECT_CANCELLED
  REQUIREMENTS_CHANGED
  OTHER
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  FOLLOW_UP
  NOTE_ADDED
  ESTIMATE
  FINAL_VALUE
  WON
  LOST
  ARCHIVED
  CALL
  WHATSAPP
  EMAIL
  MEETING
  PROPOSAL_SENT
  OTHER
}

enum InquiryType {
  PROJECT
  GENERAL
  PARTNERSHIP
  SUPPORT
  OTHER
}

enum InquiryStatus {
  NEW
  REPLIED
  CLOSED
}

model LeadCounter {
  year  Int @id
  value Int @default(0)
}

model LeadSettings {
  id            String   @id @default("leads")
  notifyEnabled Boolean  @default(false)
  notifyEmail   String?
  responseNote  String?
  updatedAt     DateTime @updatedAt
}

model Lead {
  id                    String               @id @default(cuid())
  referenceCode         String               @unique
  name                  String
  email                 String
  phone                 String?
  whatsapp              String?
  companyName           String?
  country               String?
  preferredContact      ContactMethod        @default(EMAIL)
  source                LeadSource           @default(OTHER)
  sourceUrl             String?
  projectType           String?
  platform              FeaturePlatform?
  demoId                String?
  serviceId             String?
  estimatorSubmissionId String?              @unique
  estimatedMin          Int?
  estimatedMax          Int?
  currency              EstimatorCurrency?
  finalProjectValue     Int?
  finalCurrency         EstimatorCurrency?
  priority              LeadPriority         @default(NORMAL)
  status                LeadStatus           @default(NEW)
  expectedTimeline      String?
  budgetRange           String?
  clientMessage         String?
  internalSummary       String?
  assignedTo            String?
  followUpAt            DateTime?
  followUpNote          String?
  wonAt                 DateTime?
  lostAt                DateTime?
  lostReason            LostReason?
  archivedAt            DateTime?
  sessionId             String?
  trafficChannel        TrafficChannel?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  demo                  Demo?                @relation(fields: [demoId], references: [id], onDelete: SetNull)
  service               Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  estimatorSubmission   EstimatorSubmission? @relation(fields: [estimatorSubmissionId], references: [id], onDelete: SetNull)
  notes                 LeadNote[]
  project               Project?
  activities            LeadActivity[]

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([email])
  @@index([createdAt])
  @@index([followUpAt])
  @@index([archivedAt])
  @@index([trafficChannel])
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  content    String
  authorId   String?
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String
  type       ActivityType
  title      String
  detail     String?
  authorName String?
  createdAt  DateTime     @default(now())
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model ContactInquiry {
  id               String        @id @default(cuid())
  type             InquiryType   @default(GENERAL)
  name             String
  email            String
  phone            String?
  companyName      String?
  country          String?
  message          String
  preferredContact ContactMethod @default(EMAIL)
  sourceUrl        String?
  status           InquiryStatus @default(NEW)
  priority         LeadPriority  @default(NORMAL)
  isRead           Boolean       @default(false)
  internalNote     String?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([isRead])
  @@index([createdAt])
}

enum CaseMediaKind {
  DESKTOP
  MOBILE
  DIAGRAM
  PRODUCT
}

model Media {
  id               String   @id @default(cuid())
  filename         String   @unique
  originalFilename String
  url              String   @unique
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  altText          String?
  title            String?
  caption          String?
  storageProvider  String   @default("local")
  /// Cloudinary public_id (null for files stored by the legacy local provider). Needed to delete or replace the asset.
  publicId         String?  @unique
  /// Upload purpose / Cloudinary folder, e.g. "valorian/projects".
  folder           String?
  /// Provider details: format, version, asset id.
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([mimeType])
  @@index([storageProvider])
}

model SeoSettings {
  id                 String   @id @default("seo")
  siteName           String?
  titleTemplate      String   @default("%s | {site}")
  defaultTitle       String?
  defaultDescription String?
  defaultOgImageUrl  String?
  canonicalBaseUrl   String?
  twitterHandle      String?
  allowIndexing      Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model Testimonial {
  id             String     @id @default(cuid())
  clientName     String
  companyName    String?
  position       String?
  quote          String
  imageUrl       String?
  companyLogoUrl String?
  rating         Int?
  verified       Boolean    @default(false)
  caseStudyId    String?
  serviceId      String?
  featured       Boolean    @default(false)
  active         Boolean    @default(true)
  displayOrder   Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  caseStudy      CaseStudy? @relation(fields: [caseStudyId], references: [id], onDelete: SetNull)
  service        Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([active, featured, displayOrder])
}

model CaseStudy {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  shortDescription String
  fullOverview     String           @default("")
  clientName       String?
  clientLogoUrl    String?
  clientApproved   Boolean          @default(false)
  industryId       String?
  projectType      String?
  challenge        String?
  solution         String?
  approach         String?
  keyFeatures      String[]
  results          Json             @default("[]")
  coverImageUrl    String?
  featuredImageUrl String?
  videoUrl         String?
  ctaLabel         String?
  ctaUrl           String?
  status           ContentStatus    @default(DRAFT)
  featured         Boolean          @default(false)
  publishedAt      DateTime?
  displayOrder     Int              @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  industry         Industry?        @relation(fields: [industryId], references: [id], onDelete: SetNull)
  services         Service[]        @relation("CaseStudyServices")
  technologies     Technology[]     @relation("CaseStudyTechnologies")
  demos            Demo[]           @relation("CaseStudyDemos")
  media            CaseStudyMedia[]
  testimonials     Testimonial[]

  @@index([status, publishedAt])
  @@index([featured])
  @@index([industryId])
}

model CaseStudyMedia {
  id           String        @id @default(cuid())
  caseStudyId  String
  kind         CaseMediaKind @default(DESKTOP)
  url          String
  altText      String
  caption      String?
  featured     Boolean       @default(false)
  active       Boolean       @default(true)
  displayOrder Int           @default(0)
  caseStudy    CaseStudy     @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)

  @@index([caseStudyId, displayOrder])
}

model ArticleCategory {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String    @unique
  description  String?
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

model ArticleTag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String    @unique
  articles Article[]
}

model Article {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  excerpt          String
  content          String
  featuredImageUrl String?
  featuredImageAlt String?
  authorName       String?
  authorAvatarUrl  String?
  authorBio        String?
  categoryId       String?
  status           ContentStatus    @default(DRAFT)
  featured         Boolean          @default(false)
  publishedAt      DateTime?
  readingTime      Int?
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             ArticleTag[]
  services         Service[]        @relation("ArticleServices")
  industries       Industry[]       @relation("ArticleIndustries")

  @@index([status, publishedAt])
  @@index([featured])
  @@index([categoryId])
}

enum AnalyticsEventType {
  PAGE_VIEW
  DEMO_VIEW
  DEMO_PLATFORM_SELECT
  SERVICE_VIEW
  SOLUTION_VIEW
  CASE_STUDY_VIEW
  ARTICLE_VIEW
  ESTIMATOR_START
  ESTIMATOR_STEP_COMPLETE
  ESTIMATOR_COMPLETE
  FEATURE_SELECT
  INTEGRATION_SELECT
  CTA_CLICK
  WHATSAPP_CLICK
  CONTACT_FORM_START
  CONTACT_FORM_SUBMIT
  LEAD_CREATED
}

enum TrafficChannel {
  DIRECT
  ORGANIC_SEARCH
  SOCIAL
  REFERRAL
  PAID
  UNKNOWN
}

/// Anonymous browsing session. Holds first-touch attribution only; no IP, no user agent.
model AnalyticsSession {
  id           String         @id
  channel      TrafficChannel @default(UNKNOWN)
  source       String?
  medium       String?
  campaign     String?
  content      String?
  term         String?
  referrerHost String?
  landingPath  String?
  firstSeenAt  DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())
  pageCount    Int            @default(0)

  @@index([firstSeenAt])
  @@index([channel])
  @@index([lastSeenAt])
}

/// Subject columns are plain strings (no foreign keys) so history survives deleted or archived content.
model AnalyticsEvent {
  id                    String             @id @default(cuid())
  type                  AnalyticsEventType
  sessionId             String
  path                  String?
  demoId                String?
  serviceId             String?
  solutionId            String?
  caseStudyId           String?
  articleId             String?
  entityName            String?
  platform              String?
  featureId             String?
  estimatorSubmissionId String?
  leadId                String?
  channel               TrafficChannel?
  source                String?
  metadata              Json?
  createdAt             DateTime           @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([sessionId])
  @@index([demoId, type])
  @@index([serviceId, type])
  @@index([solutionId, type])
  @@index([estimatorSubmissionId])
}

model AnalyticsSettings {
  id               String   @id @default("analytics")
  enabled          Boolean  @default(true)
  retentionDays    Int      @default(180)
  excludeAdmin     Boolean  @default(true)
  trackArticles    Boolean  @default(true)
  trackEstimator   Boolean  @default(true)
  defaultRangeDays Int      @default(30)
  idleLeadDays     Int      @default(14)
  updatedAt        DateTime @updatedAt
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGE
  PASSWORD_CHANGE
  STATUS_CHANGE
  PRICE_CHANGE
  SETTINGS_CHANGE
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  label       String
  description String?
  roles       RolePermission[]

  @@index([module])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       AdminUser[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Append-only history of meaningful admin actions. Never stores passwords, tokens or large bodies.
model AuditLog {
  id          String      @id @default(cuid())
  adminUserId String?
  adminName   String
  adminEmail  String?
  action      AuditAction
  module      String
  entityType  String?
  entityId    String?
  entityLabel String?
  summary     String
  changes     Json?
  ipMasked    String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  admin       AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([module])
  @@index([entityType])
  @@index([createdAt])
}

model SecuritySettings {
  id                 String   @id @default("security")
  sessionHours       Int      @default(168)
  minPasswordLength  Int      @default(10)
  maxFailedLogins    Int      @default(8)
  lockoutMinutes     Int      @default(15)
  auditRetentionDays Int      @default(365)
  updatedAt          DateTime @updatedAt
}

/**
 * ---------- Phase 9: Client Portal ----------
 */

enum ClientUserRole {
  OWNER
  MEMBER
}

enum ProjectStatus {
  DISCOVERY
  DESIGN
  DEVELOPMENT
  TESTING
  REVIEW
  DEPLOYMENT
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum ProjectFileCategory {
  REQUIREMENT
  DESIGN
  DOCUMENT
  DELIVERABLE
  OTHER
}

enum MessageSender {
  CLIENT
  TEAM
}

enum ClientRequestType {
  QUESTION
  CHANGE_REQUEST
  BUG_REPORT
  MAINTENANCE
}

enum ClientRequestStatus {
  OPEN
  REVIEWING
  RESOLVED
  CLOSED
}

model ClientOrganization {
  id            String       @id @default(cuid())
  companyName   String
  industry      String?
  website       String?
  logo          String?
  contactEmail  String
  contactPhone  String?
  internalNotes String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  users         ClientUser[]
  projects      Project[]

  @@index([companyName])
  @@index([active])
}

model ClientUser {
  id                 String             @id @default(cuid())
  organizationId     String
  name               String
  email              String             @unique
  phone              String?
  passwordHash       String
  role               ClientUserRole     @default(MEMBER)
  active             Boolean            @default(true)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean            @default(true)
  tokenVersion       Int                @default(0)
  failedLogins       Int                @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests           ClientRequest[]

  @@index([organizationId])
}

model Project {
  id                  String             @id @default(cuid())
  projectCode         String             @unique
  name                String
  description         String?
  organizationId      String
  status              ProjectStatus      @default(DISCOVERY)
  startDate           DateTime?
  estimatedEndDate    DateTime?
  actualEndDate       DateTime?
  progressPercentage  Int                @default(0)
  technologies        String[]
  leadId              String?            @unique
  originalEstimateMin Int?
  originalEstimateMax Int?
  estimateCurrency    EstimatorCurrency?
  finalValue          Int?
  finalCurrency       EstimatorCurrency?
  internalNotes       String?
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  organization        ClientOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead                Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  milestones          ProjectMilestone[]
  updates             ProjectUpdate[]
  files               ProjectFile[]
  messages            ProjectMessage[]
  requests            ClientRequest[]

  @@index([organizationId])
  @@index([status])
}

model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  title         String
  description   String?
  status        MilestoneStatus @default(PENDING)
  dueDate       DateTime?
  completedDate DateTime?
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectUpdate {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  content         String
  visibleToClient Boolean  @default(true)
  createdById     String?
  createdByName   String
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectFile {
  id              String              @id @default(cuid())
  projectId       String
  name            String
  storageKey      String              @unique
  fileType        String
  size            Int
  category        ProjectFileCategory @default(OTHER)
  uploadedById    String?
  uploadedByName  String
  visibleToClient Boolean             @default(true)
  createdAt       DateTime            @default(now())
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMessage {
  id              String        @id @default(cuid())
  projectId       String
  senderType      MessageSender
  senderId        String?
  senderName      String
  message         String
  visibleToClient Boolean       @default(true)
  readAt          DateTime?
  createdAt       DateTime      @default(now())
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ClientRequest {
  id          String              @id @default(cuid())
  projectId   String
  createdById String?
  title       String
  description String
  type        ClientRequestType   @default(QUESTION)
  priority    LeadPriority        @default(NORMAL)
  status      ClientRequestStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   ClientUser?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}
