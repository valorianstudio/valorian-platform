generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model SiteSetting {
  id              String   @id @default("site")
  brandName       String
  companyName     String
  tagline         String
  description     String
  primaryEmail    String
  secondaryEmail  String?
  phone           String?
  whatsapp        String?
  websiteUrl      String?
  location        String?
  linkedinUrl     String?
  githubUrl       String?
  facebookUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  defaultCurrency String   @default("USD")
  logoLightUrl    String?
  logoDarkUrl     String?
  faviconUrl      String?
  maintenanceMode Boolean  @default(false)
  copyrightText   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageKey {
  HOME
  ABOUT
  SERVICES
  SOLUTIONS
}

enum NavLocation {
  HEADER
  FOOTER
  LEGAL
}

enum TechCategory {
  FRONTEND
  BACKEND
  DATABASE
  INFRASTRUCTURE
  MOBILE
  AI
  DEVOPS
}

enum FaqCategory {
  GENERAL
  DEVELOPMENT
  PRICING
  PROCESS
  SUPPORT
}

model Page {
  key             PageKey       @id
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  noindex         Boolean       @default(false)
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]
}

model PageSection {
  id           String   @id @default(cuid())
  pageKey      PageKey
  key          String
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  content      Json
  updatedAt    DateTime @updatedAt
  page         Page     @relation(fields: [pageKey], references: [key], onDelete: Cascade)

  @@unique([pageKey, key])
  @@index([pageKey, displayOrder])
}

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  shortDescription String
  description      String
  icon             String        @default("code")
  heroTitle        String?
  heroSubtitle     String?
  features         Json          @default("[]")
  benefits         String[]
  ctaLabel         String?
  ctaUrl           String?
  featured         Boolean       @default(false)
  status           ContentStatus @default(DRAFT)
  displayOrder     Int           @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  technologies     Technology[]  @relation("ServiceTechnologies")
  industries       Industry[]    @relation("IndustryServices")

  @@index([status, displayOrder])
}

model Industry {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  shortDescription String
  overview         String
  icon             String        @default("briefcase")
  problems         String[]
  approach         String
  benefits         String[]
  ctaLabel         String?
  ctaUrl           String?
  coverImageUrl    String?
  featured         Boolean       @default(false)
  status           ContentStatus @default(DRAFT)
  displayOrder     Int           @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImageUrl       String?
  canonicalUrl     String?
  noindex          Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  technologies     Technology[]  @relation("IndustryTechnologies")
  services         Service[]     @relation("IndustryServices")
  demos            Demo[]

  @@index([status, displayOrder])
}

model Technology {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  category     TechCategory
  description  String?
  logoUrl      String?
  websiteUrl   String?
  featured     Boolean      @default(false)
  active       Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  services     Service[]    @relation("ServiceTechnologies")
  industries   Industry[]   @relation("IndustryTechnologies")
  demoPlatforms DemoPlatform[] @relation("DemoPlatformTechnologies")

  @@index([active, featured, displayOrder])
}

model ProcessStep {
  id           String   @id @default(cuid())
  title        String
  label        String?
  description  String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

model ValueProp {
  id           String   @id @default(cuid())
  title        String
  description  String
  icon         String   @default("sparkles")
  highlight    String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

model Faq {
  id           String      @id @default(cuid())
  question     String
  answer       String
  category     FaqCategory @default(GENERAL)
  featured     Boolean     @default(false)
  active       Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([active, displayOrder])
}

model Cta {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  url         String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavigationItem {
  id           String      @id @default(cuid())
  label        String
  url          String
  location     NavLocation @default(HEADER)
  displayOrder Int         @default(0)
  enabled      Boolean     @default(true)
  openInNewTab Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([location, enabled, displayOrder])
}

model FeaturedWork {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String
  imageUrl     String?
  badge        String?
  ctaUrl       String?
  featured     Boolean  @default(true)
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, featured, displayOrder])
}

enum DemoLabel {
  INTERACTIVE_CONCEPT
  PROTOTYPE
  DEMO_PRODUCT
  PRODUCTION_EXAMPLE
}

enum PlatformType {
  WEBSITE
  MOBILE
}

enum FeaturePlatform {
  WEBSITE
  MOBILE
  BOTH
}

enum ScreenshotKind {
  DESKTOP
  TABLET
  MOBILE
  DASHBOARD
  ADMIN
  CUSTOMER
  OTHER
}

enum PointType {
  BENEFIT
  USE_CASE
}

model DemoCategory {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  demos        Demo[]

  @@index([active, displayOrder])
}

model Demo {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  internalName      String?
  shortDescription  String
  fullDescription   String          @default("")
  categoryId        String?
  industryId        String?
  status            ContentStatus   @default(DRAFT)
  statusLabel       DemoLabel       @default(PROTOTYPE)
  featured          Boolean         @default(false)
  active            Boolean         @default(true)
  coverImageUrl     String?
  thumbnailUrl      String?
  badge             String?
  displayOrder      Int             @default(0)
  publishedAt       DateTime?
  problem           String?
  solution          String?
  targetUsers       String?
  targetBusinesses  String?
  outcomes          String[]
  highlight         String?
  ctaLabel          String?
  ctaUrl            String?
  metaTitle         String?
  metaDescription   String?
  ogImageUrl        String?
  canonicalUrl      String?
  noindex           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  category          DemoCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  industry          Industry?       @relation(fields: [industryId], references: [id], onDelete: SetNull)
  platforms         DemoPlatform[]
  features          DemoFeature[]
  modules           DemoModule[]
  screenshots       DemoScreenshot[]
  points            DemoPoint[]
  related           Demo[]          @relation("RelatedDemos")
  relatedBy         Demo[]          @relation("RelatedDemos")

  @@index([status, active, featured, displayOrder])
  @@index([categoryId])
  @@index([industryId])
}

model DemoPlatform {
  id           String       @id @default(cuid())
  demoId       String
  type         PlatformType
  enabled      Boolean      @default(false)
  title        String?
  description  String?
  demoUrl      String?
  videoUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  notes        String?
  android      Boolean      @default(false)
  ios          Boolean      @default(false)
  playStoreUrl String?
  appStoreUrl  String?
  demo         Demo         @relation(fields: [demoId], references: [id], onDelete: Cascade)
  technologies Technology[] @relation("DemoPlatformTechnologies")

  @@unique([demoId, type])
}

model DemoFeature {
  id           String          @id @default(cuid())
  demoId       String
  platform     FeaturePlatform @default(BOTH)
  title        String
  description  String?
  icon         String?
  featured     Boolean         @default(false)
  active       Boolean         @default(true)
  displayOrder Int             @default(0)
  demo         Demo            @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, displayOrder])
}

model DemoModule {
  id           String          @id @default(cuid())
  demoId       String
  platform     FeaturePlatform @default(BOTH)
  title        String
  description  String?
  icon         String?
  active       Boolean         @default(true)
  displayOrder Int             @default(0)
  demo         Demo            @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, displayOrder])
}

model DemoScreenshot {
  id           String         @id @default(cuid())
  demoId       String
  platform     PlatformType   @default(WEBSITE)
  kind         ScreenshotKind @default(DESKTOP)
  url          String
  altText      String
  caption      String?
  featured     Boolean        @default(false)
  active       Boolean        @default(true)
  displayOrder Int            @default(0)
  demo         Demo           @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, displayOrder])
}

model DemoPoint {
  id           String    @id @default(cuid())
  demoId       String
  type         PointType
  title        String
  description  String?
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  demo         Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, type, displayOrder])
}
